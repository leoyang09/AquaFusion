# Copy this file to .env.server and fill in real values.
# .env.server is gitignored. Never commit the real file.

# Supabase: use the SERVICE ROLE key (not the anon key) for server-side inserts.
# Find it at: Supabase Dashboard > Project Settings > API > service_role
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# Resend API key
RESEND_API_KEY=YOUR_RESEND_API_KEY

# Bearer token that clients must send to /api/ingest (any strong random string)
GATEWAY_SECRET=YOUR_GATEWAY_SECRET

# Sender address (must be on a Resend-verified domain)
FROM_EMAIL=AquaFusion Alerts <alerts@yourdomain.com>
